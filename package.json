{
  "name": "tiktok-bridge-ui",
  "private": true,
  "version": "1.0.31",
  "description": "MyGamePack 用の設定編集UI（TikTok Bridge統合UI）",
  "author": "Douma Akahori",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:bridge": "node bridge/test/simulate_events.js",
    "test:app": "node --test electron/test/*.test.cjs",
    "verify": "npm run typecheck && npm run test:bridge && npm run test:app && npm run build",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "electron:prod": "electron .",
    "prepare:bridge-runtime": "node scripts/prepare-bridge-runtime.cjs",
    "prepare:server-template": "node scripts/prepare-server-template.cjs",
    "pack:win": "npm run build && npm run prepare:bridge-runtime && npm run prepare:server-template && electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.24",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.douma.mygamepack.bridgeui",
    "productName": "MyGamePack Bridge UI",
    "copyright": "Copyright © 2026 Douma Akahori",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "testakahori",
      "repo": "My-game-pack"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!electron/test/**",
      "bridge/roulette.cjs",
      "bridge/feature_engine.js",
      "bridge/event_rules.cjs",
      "bridge/package.json"
    ],
    "extraResources": [
      {
        "from": "bridge",
        "to": "bridge",
        "filter": [
          "**/*",
          "!logs/**",
          "!node/**",
          "!node_modules/**",
          "!test/**",
          "!presets/**",
          "!operations-history.json",
          "!runtime-status.json",
          "!stream-sessions.json",
          "!stream-metrics.jsonl"
        ]
      },
      {
        "from": "build/bridge-bundle",
        "to": "bridge"
      },
      {
        "from": "GiftsViewer/tools-bundled",
        "to": "gv-tools"
      },
      {
        "from": "build/server-template",
        "to": "server/Douma_Craft"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.bat",
      "**/*.cmd",
      "**/*.ps1",
      "**/*.exe",
      "**/*.dll"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyGamePack Bridge UI",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "MyGamePack-Bridge-UI-Setup-${version}.${ext}",
      "unicode": true
    }
  }
}
